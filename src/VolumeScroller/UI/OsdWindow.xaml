<Window x:Class="VolumeScroller.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Scroller OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <DropShadowEffect x:Key="PillShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.6"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="14,10,14,12">
        <!-- Floating Pill Container -->
        <Border Background="#F018181B"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="19"
                Padding="16,8,20,8"
                Effect="{StaticResource PillShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Speaker Icon -->
                <Grid Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                    <!-- Speaker base & cone -->
                    <Path x:Name="SpeakerBodyPath"
                          Fill="#FFFFFF"
                          Data="M 3,8 L 7,8 L 12,3 L 12,21 L 7,16 L 3,16 Z" />

                    <!-- Mute Cross / Slash -->
                    <Path x:Name="MuteCrossPath"
                          Stroke="#FF4D4D"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 15,8 L 22,16 M 22,8 L 15,16"
                          Visibility="Collapsed" />

                    <!-- Sound Wave Low -->
                    <Path x:Name="WaveLowPath"
                          Stroke="#FFFFFF"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 15,9 C 16.5,10.5 16.5,13.5 15,15" />

                    <!-- Sound Wave High -->
                    <Path x:Name="WaveHighPath"
                          Stroke="#FFFFFF"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 18,6 C 21,9 21,15 18,18" />
                </Grid>

                <!-- Modern Progress Bar Container -->
                <Grid Width="110" Height="6" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!-- Track Background -->
                    <Border Background="#33FFFFFF" CornerRadius="3" />
                    <!-- Track Fill -->
                    <Border x:Name="VolumeTrackFill"
                            Background="#0078D4"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="55" />
                </Grid>

                <!-- Percentage Value Text -->
                <TextBlock x:Name="VolumeText"
                           Text="50%"
                           Foreground="#FFFFFF"
                           FontSize="16"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           MinWidth="48"
                           TextAlignment="Right" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
